cmake_minimum_required(VERSION 3.24)
# 由 {{ generatorVersion }} 生成。第三方依赖：无（仅标准库）。
# FR-002 政策：如需引入开源数学库，必须在此显式固定版本并声明来源。
project({{ modelName }} LANGUAGES CXX)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
  set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
endif()
add_executable({{ modelName }} model_{{ modelName }}.cpp)
target_include_directories({{ modelName }} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/mcruntime)
