// Generated by {{ generatorVersion }} from model {{ modelName }}.
// 确定性输出：不含时间戳或路径（FR-007）。源模型为唯一事实来源（FR-008）。
#include <cmath>
#include <cstdio>
#include <cstring>
#include <stdexcept>
#include <string>
#include <vector>

#include "rk4.hpp"
#include "csv_writer.hpp"
#include "newton.hpp"

struct Vars {
## for p in parameters
  {{ p.cppType }} {{ p.cppName }};  // {{ p.comment }}
## endfor
## for s in states
  {{ s.cppType }} {{ s.cppName }};  // {{ s.comment }}
## endfor
## for a in algebraics
  {{ a.cppType }} {{ a.cppName }};  // {{ a.comment }}
## endfor
};

static Vars make_constants() {
  Vars v{};
## for p in parameters
  v.{{ p.cppName }} = {{ p.initLiteral }};
## endfor
  return v;
}

static void sync_from_y(const double* y, Vars& v) {
## for s in states
  v.{{ s.cppName }} = y[{{ s.index }}];
## endfor
}

static void sync_to_y(const Vars& v, double* y) {
## for s in states
  y[{{ s.index }}] = v.{{ s.cppName }};
## endfor
}

static void apply_aliases(Vars& v) {
## for eq in aliasEquations
  {{ eq.lhsCpp }} = {{ eq.rhsCpp }};
## endfor
}

static void compute_algebraic(Vars& v) {
{{ algebraicBody }}  apply_aliases(v);
}

static void initialize(Vars& v) {
## for d in initDerLocals
  double {{ d }} = 0.0;
## endfor
## for g in initGuesses
  {{ g.lhsCpp }} = {{ g.literal }};
## endfor
{{ initialBody }}  (void)v;
## for d in initDerLocals
  (void){{ d }};
## endfor
}

static void deriv(const Vars& vin, Vars& d) {
  Vars v = vin;
  compute_algebraic(v);
## for eq in odeEquations
  {{ eq.lhsCpp }} = {{ eq.rhsCpp }};
## endfor
}

int main() {
  const std::string resultPath = "{{ modelName }}_result.csv";

  try {
    Vars v = make_constants();
    initialize(v);
    const double t0 = {{ startTime }};
    const double tEnd = {{ stopTime }};
    const long steps = {{ steps }}L;
    const double h = (tEnd - t0) / static_cast<double>(steps);
    double t = t0;

    mcruntime::CsvWriter csv(resultPath, {"time"{{ csvExtraCols }}});

    std::vector<double> y({{ stateCount }});
    sync_to_y(v, y.data());

    auto rhs = [&](double tt, const double* yy, double* dy) {
      (void)tt;
      Vars s = v;
      sync_from_y(yy, s);
      Vars dd{};
      deriv(s, dd);
## for s in states
      dy[{{ s.index }}] = static_cast<double>(dd.{{ s.cppName }});
## endfor
    };

    auto writeRow = [&](double rowTime) {
      Vars s = v;
      compute_algebraic(s);
      csv.writeRow(rowTime, {{ writeRowList }});
    };

    writeRow(t);
    for (long kStep = 0; kStep < steps; ++kStep) {
      mcruntime::rk4_step(h, t, y, rhs);
      sync_from_y(y.data(), v);
      writeRow(t);
    }

    return 0;
  } catch (const std::runtime_error& e) {
    std::fprintf(stderr, "%s\n", e.what());
    std::remove(resultPath.c_str());
    return 3;
  }
}
